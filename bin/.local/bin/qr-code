#!/usr/bin/env bash
# Skapar en statisk QR-kod från en text eller URL.
# Användning: qr-code <url> [utfil.png]
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Användning: qr-code <url eller text> [utfil.png]" >&2
  exit 1
fi

input="$1"
out="${2:-qr.png}"

if ! command -v uv >/dev/null 2>&1; then
  echo "Hittade inte uv. Installera det först." >&2
  exit 1
fi

uv run --quiet --no-project --with "qrcode[pil]" python -c \
  'import sys, qrcode; qrcode.make(sys.argv[1]).save(sys.argv[2])' \
  "$input" "$out"

echo "Sparade QR-kod till $out"
